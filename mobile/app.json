{
  "expo": {
    "name": "Ghana Road Defect Collector",
    "slug": "ghana-road-defect-collector",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "roaddefectcollector",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.hatiekuboateng.roaddefectcollector",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B5D4B",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hatiekuboateng.roaddefectcollector"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Road Defect Collector to take road photos for reports.",
          "photosPermission": "Allow Road Defect Collector to select a road photo for a report.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Road Defect Collector to attach the road's location to your report."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B5D4B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiBaseUrl": "https://road-defect-collector.vercel.app"
    }
  }
}
